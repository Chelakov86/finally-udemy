# Required: Google Gemini API key for LLM chat functionality.
GEMINI_API_KEY=your-google-gemini-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# If not set, the built-in market simulator is used.
MASSIVE_API_KEY=

# Optional: deterministic mock LLM responses for development and E2E tests.
LLM_MOCK=false

# Optional: LiteLLM model identifier.
LLM_MODEL=gemini/gemma-4-31b-it

# Optional for local use, required before exposing the app on a public URL.
# WARNING: Do not deploy FinAlly to a public cloud URL without APP_PASSWORD
# or an external authentication proxy such as Nginx Basic Auth or Cloudflare Access.
APP_PASSWORD=
